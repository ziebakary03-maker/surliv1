# Copiez ce fichier en .env et adaptez les valeurs. Ne committez jamais
# le vrai .env (secrets de prod) — voir .gitignore.

# --- Base de données ---
DATABASE_URL=postgresql://surliv:surliv@localhost:5432/surliv_test
DB_POOL_MAX_CONN=5

# --- Stockage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/surliv-storage
# Si STORAGE_BACKEND=s3 :
S3_ENDPOINT=
S3_BUCKET=object-tracker
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Limites vidéo ---
MAX_VIDEO_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=120
MAX_CONCURRENT_JOBS=2

# --- Détecteur ---
DEVICE=cpu
DETECTOR_BACKEND=opencv
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.4
BALL_CLASS_ID=0
CUP_CLASS_ID=1

# --- Tracking / ré-identification ---
MAX_OCCLUSION_FRAMES=45
REID_APPEARANCE_WEIGHT=0.4
REID_MOTION_WEIGHT=0.6
CONTAINER_ASSOCIATION_THRESHOLD=0.75
OCCLUSION_PENDING_FRAMES=2
REIDENTIFICATION_THRESHOLD=0.75
AMBIGUOUS_THRESHOLD=0.45
MOTION_WEIGHT=0.25
APPEARANCE_WEIGHT=0.30
TRAJECTORY_WEIGHT=0.20
CONTAINER_WEIGHT=0.25
POSITION_PREDICTION_WEIGHT=0.5

# --- Worker ---
WORKER_POLL_INTERVAL=2
PROGRESS_UPDATE_INTERVAL_SECONDS=0.25
JOB_PROCESSING_TIMEOUT_SECONDS=900
JOB_AWAITING_TARGET_TIMEOUT_SECONDS=3600
